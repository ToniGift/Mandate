# PayPal sandbox: developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Email of your sandbox PERSONAL account (receives the test payouts)
PAYPAL_PERSONAL_EMAIL=

# AI agent: Nebius Token Factory (any OpenAI-compatible provider also works)
# API key: Nebius Token Factory console > API keys
NEBIUS_API_KEY=
# Model used in our tests: deepseek-ai/DeepSeek-V4.1-Flash-1017
NEBIUS_MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash-1017
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Optional settings, shown with their defaults. Remove the # to change one.
# MANDATE_PORT=8000
# MANDATE_GATEWAY_URL=http://127.0.0.1:8000/mcp
# DASHBOARD_PORT=8001
# Hosting only: a host other than 127.0.0.1 or localhost makes the dashboard a public server.
# It then refuses to start unless MANDATE_FAKE_PAYOUTS=1, and it never reads this file.
# DASHBOARD_HOST=127.0.0.1

# Offline demo mode: payouts are simulated and PayPal is not contacted. Needs no PayPal values.
# The default is off, which means real PayPal sandbox payouts.
# MANDATE_FAKE_PAYOUTS=1
