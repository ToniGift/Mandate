# PayPal sandbox credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Sandbox personal account email that receives the probe payout
PAYPAL_PERSONAL_EMAIL=

# Nebius Token Factory (OpenAI-compatible API) used by the AI agent
# Choose a current text model that supports function calling from the Nebius model list
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Optional: gateway port (default 8000) and the URL the agent uses to reach it
# MANDATE_PORT=8000
# MANDATE_GATEWAY_URL=http://127.0.0.1:8000/mcp
